{
  "languageId": "typescript",
  "version": "1.1.0",
  "extensions": [
    "ts",
    "tsx"
  ],
  "lspLanguageIdByExt": {
    "tsx": "typescriptreact"
  },
  "serverId": "typescript",
  "server": {
    "strategy": "node-module",
    "module": "typescript-language-server",
    "args": [
      "--stdio"
    ],
    "install": {
      "kind": "npm",
      "packages": [
        "typescript-language-server",
        "typescript"
      ]
    }
  },
  "rootMarker": "tsconfig.json",
  "debug": {
    "type": "pwa-node",
    "install": {
      "kind": "github-release",
      "name": "js-debug",
      "repo": "microsoft/vscode-js-debug",
      "tag": "v1.140.0",
      "asset": "js-debug-dap-v1.140.0.tar.gz",
      "sha256": "27dab92937ec1ab35821ae955aac867544fe06a1b6307229049f2d789af10968"
    },
    "adapter": {
      "strategy": "path",
      "command": "node",
      "args": [
        "${tools}/js-debug/js-debug/src/dapDebugServer.js",
        "${port}",
        "127.0.0.1"
      ]
    },
    "launch": {
      "type": "pwa-node",
      "request": "launch",
      "name": "${fileBasename}",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  },
  "initializationOptions": {
    "preferences": {
      "includeCompletionsForModuleExports": true,
      "includeCompletionsWithSnippetText": true,
      "importModuleSpecifierPreference": "shortest",
      "includeInlayParameterNameHints": "literals",
      "includeInlayParameterNameHintsWhenArgumentMatchesName": false,
      "includeInlayFunctionParameterTypeHints": true,
      "includeInlayVariableTypeHints": true,
      "includeInlayVariableTypeHintsWhenTypeMatchesName": false,
      "includeInlayPropertyDeclarationTypeHints": true,
      "includeInlayFunctionLikeReturnTypeHints": true,
      "includeInlayEnumMemberValueHints": true
    }
  },
  "extraTokenColors": [
    {
      "token": "interface",
      "foreground": "4EC9B0"
    },
    {
      "token": "member",
      "foreground": "DCDCAA"
    }
  ]
}
